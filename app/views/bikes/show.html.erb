<h1><%= @bike.name %></h1>

<p><strong>Brand:</strong> <%= @bike.brand %></p>
<p><strong>Added on:</strong> <%= @bike.created_at.strftime("%B %d, %Y") %></p>

<p>
  <%= link_to "Edit Bike", edit_bike_path(@bike) %>
  <%= button_to "Delete Bike", bike_path(@bike), method: :delete %>
  <%= link_to "Back to My Bikes", bikes_path %>
</p>
