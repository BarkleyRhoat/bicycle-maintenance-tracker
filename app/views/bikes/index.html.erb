<h1>Welcome, <%= current_user.name %></h1>

<h2>My Bikes</h2>

<% if @bikes.any? %>
  <ul class="bikes-list">
    <% @bikes.each do |bike| %>
      <li>
        <strong><%= link_to bike.name, bike_path(bike) %></strong> -
        <strong><%= bike.brand %></strong>
        <%= link_to "Edit", edit_bike_path(bike) %>
        <%= button_to "Delete", bike_path(bike), method: :delete %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>You have not added any bikes yet.</p>
<% end %>

<%= link_to "Add a New Bike", new_bike_path %>
