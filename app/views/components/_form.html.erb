<%= render "shared/errors", object: component %>

<%= form_with model: component do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :component_type, "Component Type" %>
    <%= form.text_field :component_type, placeholder: "e.g. Chain, Tires, Cassette, Brakes" %>
  </div>

  <div>
    <%= form.label :expected_lifespan_km, "Expected Lifespan (km)" %>
    <%= form.number_field :expected_lifespan_km, min: 1 %>
  </div>

  <%= form.submit %>
<% end %>
