<h1><%= @component.name %></h1>

<p><strong>Type:</strong> <%= @component.component_type %></p>

<p>
  <strong>Expected Lifespan:</strong> <%= @component.expected_lifespan_km ? "#{@component.expected_lifespan_km} km" : "Indefinite" %>
</p>

<h2>Installed On Bikes</h2>

<% if @component_bike_components.any? %>
  <ul class="component-bikes-list">
    <% @component_bike_components.each do |bike_component| %>
      <li>
        <strong><%= link_to bike_component.bike.name, bike_path(bike_component.bike) %></strong>
        (<%= bike_component.bike.brand %>) | Installed on:
        <%= bike_component.installed_on.strftime("%B %d, %Y") %> | Current KM:
        <%= bike_component.current_km %>
      </li>
    <% end %>
  </ul>
<% else %>
<p class="empty-state">Not installed on any bikes.</p>
<% end %>

<h2>Maintenance History</h2>

<% if @component_maintenance_logs.any? %>
  <ul class="component-maintenance-logs-list">
    <% @component_maintenance_logs.each do |log| %>
      <li>
        <strong><%= link_to log.service_date.strftime("%B %d, %Y"), bike_maintenance_log_path(log.bike, log) %></strong>
        | <%= log.description %> | KM at service: <%= log.km_at_service %>
        <% if log.bike %>
          | Bike: <%= link_to log.bike.name, bike_path(log.bike) %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
<p class="empty-state">No maintenance logs for this component yet.</p>
<% end %>

<p class="page-actions">
  <%= link_to "Edit Component", edit_component_path(@component) %>
  <%= button_to "Delete Component", component_path(@component), method: :delete %>
  <%= link_to "Back to Components", components_path %>
</p>
