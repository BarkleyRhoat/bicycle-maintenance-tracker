<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || "Bicycle Maintenance Tracker" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bicycle Maintenance Tracker">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <div class: "site-title"> 
          <span aria-hidden="true">🚲</span>
          Bicycle Maintenance Tracker
        </div>

        <nav class="site-nav">
          <% if logged_in? %>
            <%= link_to "My Bikes", bikes_path, class: ("active" if controller_name == "bikes") %>
            <%= link_to "Components", components_path, class: ("active" if controller_name == "components") %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "nav-logout", form_class: "nav-logout-form" %>
          <% else %>
            <%= link_to "Log In", login_path %>
            <%= link_to "Sign Up", signup_path, class: "nav-signup" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash[:notice] %>
      <div class="container">
        <div class="notice"><%= flash[:notice] %></div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="container">
        <div class="alert"><%= flash[:alert] %></div>
      </div>
    <% end %>

    <main class="site-main container">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        Bicycle Maintenance Tracker
      </div>
    </footer>
  </body>
</html>
